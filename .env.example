# MongoDB Atlas, one database per environment (prod / preview / ci).
# Local dev uses the preview database: test content, never the live site.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/margot-preview
# openssl rand -base64 32
PAYLOAD_SECRET=
# Media storage. Leave unset locally: uploads go to ./media. Required on Vercel.
# S3_BUCKET=
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=preview
